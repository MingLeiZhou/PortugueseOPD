# Manuscript workspace: track only the canonical source, its reproducible
# scientific-figure generator, provenance manifest and publication figures.
# Historical drafts, downloaded papers and document-build output remain local.
paper/*
!paper/PT60_Sep16.MD
!paper/figure_manifest.csv
!paper/scripts/
paper/scripts/*
!paper/scripts/generate_pt60_scientific_figures.py
!paper/scripts/pt60-paper.mplstyle
!paper/figures/
paper/figures/*
!paper/figures/scientific/
!paper/figures/scientific/**
# Matplotlib SVG maps can contain millions of path coordinates. Keep PDF as
# the publication vector format and PNG for repository/Markdown previews.
paper/figures/scientific/*.svg
paper/ScientificData/
paper/*_draft.docx
paper/*_v[0-9]*.pdf
paper/arxiv_submission*.tar.gz
paper/figures/generated/*.psd
paper/figures/generated/*.xcf

